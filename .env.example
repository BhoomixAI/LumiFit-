# Copy this file to .env.local and fill in real values.

# AI Stylist chat (Google Gemini via OpenAI-compatible endpoint)
GEMINI_API_KEY=
# Optional: override the Gemini model used by /api/ai-chat
GEMINI_MODEL=gemini-3.6-flash

# Virtual try-on (YouCam AI Clothes API)
YOUCAM_API_KEY=
# Optional: override the YouCam API host
# YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com

# Profile storage (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed for `node import-catalog.js`
# SUPABASE_SERVICE_ROLE_KEY=
